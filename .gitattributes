# Normalize line endings; store LF in repo
* text=auto eol=lf

# TypeScript and JavaScript files
*.ts   text eol=lf
*.tsx  text eol=lf
*.js   text eol=lf
*.jsx  text eol=lf
*.mjs  text eol=lf
*.cjs  text eol=lf

# Markdown and documentation
*.md   text eol=lf

# CSS and styling
*.css  text eol=lf
*.scss text eol=lf

# JSON and configuration
*.json text eol=lf

# YAML
*.yml  text eol=lf
*.yaml text eol=lf

# Shell scripts (Unix LF)
*.sh   text eol=lf

# PowerShell scripts (CRLF for Windows compatibility)
*.ps1  text eol=crlf

# Exclude binary files from text normalization
*.png  binary
*.jpg  binary
*.jpeg binary
*.gif  binary
*.ico  binary
*.mp3  binary
*.mp4  binary
*.woff binary
*.woff2 binary
*.eot  binary
*.ttf  binary
*.otf  binary
