# Web UI (Next.js) public config
NEXT_PUBLIC_ARCHON_URL=http://localhost:7700
# Real ARCHON endpoints (override per environment)
NEXT_PUBLIC_ARCHON_CHAT_PATH=/v1/chat
NEXT_PUBLIC_ARCHON_STREAM_PATH=/v1/chat/stream
# Hard-disable Direct mode in dev if needed (true/false)
NEXT_PUBLIC_DIRECT_DISABLED=false
