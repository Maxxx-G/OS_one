# OS One Web-UI Environment Configuration
# Copy this file to .env.local and configure for your deployment

# ============================================
# PROVIDER CONFIGURATION (Required)
# ============================================

# Primary LLM provider (options: OpenAIResponses, Ollama, Anthropic, etc.)
NEXT_PUBLIC_PROVIDER=OpenAIResponses

# OpenAI API key (required if using OpenAIResponses)
OPENAI_API_KEY=sk-xxxx...

# ============================================
# LOCAL LLM CONFIGURATION (Choose one)
# ============================================

# Ollama base URL (local LLM server)
OLLAMA_BASE=http://localhost:11434

# OR Open-WebUI base URL (alternative local LLM)
# OPENWEBUI_BASE=http://localhost:3000

# DeepSeek model for voice reasoning (if using voice loop)
DEEPSEEK_MODEL=deepseek-r1:8b

# ============================================
# LIVE ROUTER / ARCHON (Optional)
# ============================================

# Live Router base URL (production deployments)
NEXT_PUBLIC_LIVE_BASE=

# Archon API URL (for TTS and audio processing)
NEXT_PUBLIC_ARCHON_URL=http://localhost:7700

# ============================================
# VOICE FEATURES (Experimental)
# ============================================

# Enable voice reasoning loop (0=disabled, 1=enabled)
NEXT_PUBLIC_VOICE_LOOP=0

# Enable streaming TTS (0=disabled, 1=enabled)
NEXT_PUBLIC_TTS_STREAM=0

# Show development HUD for voice diagnostics (0=disabled, 1=enabled)
NEXT_PUBLIC_DEVHUD=0

# ============================================
# AGENT MODE
# ============================================

# Agent mode: 0=Mediated (default), 1=Direct
NEXT_PUBLIC_DIRECT_AGENT=0

# ============================================
# ADDITIONAL SETTINGS
# ============================================

# Chat Backend URL - model server endpoint for /api/chat
CHAT_BACKEND_URL=http://localhost:7700/v1/chat
# Note: When SEC_COMMS_ENFORCE=1 is set in the UI runtime,
# the client adds x-sec-local-only: 1 header for local development

# Session persistence key (optional, defaults to 'os1.session')
# SESSION_KEY=os1.session

# Enable debug logging (0=disabled, 1=enabled)
# DEBUG=0

